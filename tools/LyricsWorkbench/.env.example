# 可选：已注册的 LRCLIB 服务端密钥。复制到 .env.local 后填写。
# LRCLIB_API_KEY=

# 可选：扩充搜索曲库。作者曲库不需要凭据。不要使用 VITE_ 前缀。
# JAMENDO_CLIENT_ID=
# 仅在取得 Jamendo 对离线打包的许可，并确认每个曲目的音频与歌词许可后启用。
# JAMENDO_BUNDLE_AUTHORIZED=1
# JAMENDO_APPROVED_MP3_SHA256=123456:对应的64位小写SHA256,234567:对应的64位小写SHA256

# 可选：锁定已核对的 B 站分集与原音轨。普通公开音频下载不要求配置此项。
# 格式：BV号:分集号:CID:原始 30280 音轨的 64 位小写 SHA256；多项以逗号分隔。
# BILIBILI_APPROVED_AUDIO_SHA256=

# 可选：本机歌词工作台只在此曲库的原音频旁保存同名 .lrc，不写音频。
# TINYTUNE_AUDIO_LIBRARY=/absolute/path/to/audio
