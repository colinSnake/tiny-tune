{
  "name": "tinytune-lyrics-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx --watch src/server.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env.local dist/server/index.js",
    "build": "pnpm typecheck && vite build && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "collect": "node --env-file-if-exists=.env.local --import tsx src/collect.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "jszip": "^3.10.1",
    "lucide-react": "1.78.0",
    "music-metadata": "12.7.0",
    "opencc-js": "1.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fastify/middie": "^9.3.9",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
